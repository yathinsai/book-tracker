# Copy this file to .env for all local Node.js development and builds. Never commit .env.
# npm run dev and npm run build load this file automatically.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Node server or trusted maintenance script only. Never expose this key to the browser.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Optional: identifies the deployment environment for logs and diagnostics.
BOOKTRACKER_ENV=development

# false keeps the current localStorage MVP. true enables the Supabase Auth shell
# in the static build; it does not enable database CRUD until the repository adapter exists.
FEATURE_DB=false

# Optional local Node development-server port.
PORT=8080
